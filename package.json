{
  "name": "@arjunmaybe/termail",
  "version": "1.0.0",
  "description": "Terminal email client built with Bun, TypeScript, and OpenTUI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arjunmaybe/Termail.git"
  },
  "homepage": "https://termail.pages.dev",
  "bugs": {
    "url": "https://github.com/arjunmaybe/Termail/issues"
  },
  "keywords": [
    "terminal",
    "email",
    "email-client",
    "cli",
    "tui",
    "imap",
    "smtp",
    "bun",
    "opentui"
  ],
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "termail": "./dist/main.js"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "prepack": "bun run build",
    "dev": "bun run --watch src/main.ts",
    "build": "bun build src/main.ts --outdir dist --target bun --external '@opentui/core-*'",
    "start": "bun run dist/main.js",
    "test": "bun test",
    "test:sequential": "bun test --parallel=1",
    "test:vitest": "vitest run",
    "test:watch": "bun test --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "^0.6.6",
    "@preact/signals": "^2.11.3",
    "imapflow": "^2.5.0",
    "mailparser": "^3.9.37",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ],
  "packageManager": "bun@1.4.1"
}
