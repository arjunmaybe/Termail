{
  "name": "termail",
  "version": "1.0.0",
  "description": "Terminal email client built with Bun, TypeScript, and OpenTUI",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "build": "bun build src/main.ts --outdir dist --target bun",
    "start": "bun run dist/main.js",
    "test": "bun test",
    "test:sequential": "bun test --parallel=1",
    "test:vitest": "vitest run",
    "test:watch": "bun test --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "^0.4.2",
    "@preact/signals": "^1.3.0",
    "imapflow": "^1.7.8",
    "mailparser": "^3.9.37",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  },
  "trustedDependencies": ["@biomejs/biome"],
  "packageManager": "bun@1.4.1"
}
