{
  "name": "termail",
  "version": "0.1.0",
  "description": "Modern TypeScript terminal email client",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "build": "bun build src/main.ts --outdir dist --target bun",
    "start": "bun run dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "^0.4.2",
    "@preact/signals": "^1.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "trustedDependencies": ["@biomejs/biome"],
  "packageManager": "bun@1.1.29"
}
