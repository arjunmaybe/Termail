# Termail Configuration
# Copy this file to .env and customize

# Database
# TERMAIL_DB_PATH=~/.local/share/termail/db.sqlite

# Config
# TERMAIL_CONFIG_PATH=~/.config/termail/config.json

# UI
# TERMAIL_THEME=dark
# TERMAIL_PANE_RATIO=0.3

# AI assistance (optional OpenRouter integration)
# Enable with "ai": { "enabled": true, ... } in config.json.
# The API key always comes from the environment, never from config.json.
# TERMAIL_AI_API_KEY=<your-openrouter-api-key>

# Email credentials (IMAP/SMTP password or OAuth2 token).
# Never stored in config.json or the database. Prefer the one-time OS
# credential-store setup instead; use these variables to override it
# (development, headless use) or on platforms without an OS store.
# Replace <account-id> with your account id (non-alphanumeric
# characters become `_`), e.g. account `work` below.
# TERMAIL_WORK_PASSWORD=<your-app-password>
# TERMAIL_WORK_OAUTH_TOKEN=<your-oauth2-access-token>